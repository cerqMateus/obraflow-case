{
  "name": "@obraflow/backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently --kill-others --success first \"tsc --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src test scripts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "db:generate": "tsx scripts/prisma.ts generate",
    "db:migrate": "tsx scripts/prisma.ts migrate deploy",
    "db:seed:base": "tsx scripts/seed-base.ts",
    "test:unit": "jest --runInBand --testPathPattern=unit",
    "test:integration": "jest --runInBand --testPathPattern=integration"
  },
  "dependencies": {
    "@nestjs/common": "11.1.16",
    "@nestjs/core": "11.1.16",
    "@nestjs/platform-express": "11.1.16",
    "@prisma/client": "6.19.3",
    "decimal.js": "10.6.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "concurrently": "9.2.1",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "ts-jest": "29.4.5",
    "tsx": "4.20.6"
  }
}
