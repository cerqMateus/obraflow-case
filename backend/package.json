{
  "name": "@obraflow/backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently --kill-others --success first \"tsc --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src test scripts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "db:generate": "tsx scripts/prisma.ts generate",
    "db:migrate": "tsx scripts/prisma.ts migrate deploy",
    "db:seed:base": "tsx scripts/seed-base.ts",
    "test:unit": "jest --runInBand --testPathPattern=unit",
    "test:integration": "jest --runInBand --testPathPattern=integration"
  },
  "dependencies": {
    "@nestjs/common": "11.1.16",
    "@nestjs/core": "11.1.16",
    "@nestjs/platform-express": "11.1.16",
    "@prisma/client": "6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "connect-pg-simple": "10.0.0",
    "decimal.js": "10.6.0",
    "express": "5.1.0",
    "express-session": "1.18.2",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "5.0.5",
    "@types/express-session": "1.18.2",
    "@types/jest": "29.5.14",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "concurrently": "9.2.1",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "tsx": "4.20.6"
  }
}
