# Copie para .env e substitua os placeholders antes de iniciar.
POSTGRES_DB=obraflow
POSTGRES_USER=obraflow
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
SESSION_SECRET=REPLACE_WITH_ANOTHER_RANDOM_HEX
APP_ORIGIN=http://localhost:8080
HTTP_PORT=8080
# Opcional: IPs literais separados por virgula dos proxies confiaveis; vazio nao confia em headers.
TRUST_PROXY_IPS=
