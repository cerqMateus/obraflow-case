generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  operator
}

enum OrderStatus {
  pending
  approved
  rejected
}

enum StepStatus {
  waiting
  pending
  approved
  rejected
  skipped
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  name         String @db.VarChar(120)
  email        String @unique @db.VarChar(254)
  passwordHash String @db.Text
  role         Role
  assignments  ProjectResponsibility[] @relation("Operator")
  grants       ProjectResponsibility[] @relation("Grantor")
  revocations  ProjectResponsibility[] @relation("Revoker")
  orders       PurchaseOrder[]
  steps        ApprovalStep[] @relation("Assignee")
  decisions    ApprovalStep[] @relation("Decider")
}

// Physical layout required by connect-pg-simple; identity/CSRF live in sess.
model Session {
  sid    String @id @db.VarChar
  sess   Json   @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

model Project {
  id               String @id @default(uuid()) @db.Uuid
  name             String @db.VarChar(120)
  rulesRevision    Int @default(0)
  responsibilities ProjectResponsibility[]
  rules            ApprovalRule[]
  orders           PurchaseOrder[]
}

model Supplier {
  id     String @id @default(uuid()) @db.Uuid
  name   String @db.VarChar(160)
  orders PurchaseOrder[]
}

model ProjectResponsibility {
  id          String @id @default(uuid()) @db.Uuid
  projectId   String @db.Uuid
  operatorId  String @db.Uuid
  active      Boolean @default(true)
  grantedById String @db.Uuid
  grantedAt   DateTime @default(now()) @db.Timestamptz(3)
  revokedById String? @db.Uuid
  revokedAt   DateTime? @db.Timestamptz(3)
  project     Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  operator    User @relation("Operator", fields: [operatorId], references: [id], onDelete: Restrict)
  grantedBy   User @relation("Grantor", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedBy   User? @relation("Revoker", fields: [revokedById], references: [id], onDelete: Restrict)
  ruleSteps   RuleStep[]
  orderSteps  ApprovalStep[]

  @@index([projectId, active])
  @@index([operatorId, active])
}

model ApprovalRule {
  id             String @id @default(uuid()) @db.Uuid
  projectId      String @db.Uuid
  lowerExclusive Decimal? @db.Decimal(18, 2)
  upperInclusive Decimal? @db.Decimal(18, 2)
  project        Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  steps          RuleStep[]
  orders         PurchaseOrder[]

  @@index([projectId])
}

model RuleStep {
  id               String @id @default(uuid()) @db.Uuid
  ruleId           String @db.Uuid
  responsibilityId String @db.Uuid
  position         Int
  rule             ApprovalRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  responsibility   ProjectResponsibility @relation(fields: [responsibilityId], references: [id], onDelete: Restrict)

  @@unique([ruleId, position])
  @@unique([ruleId, responsibilityId])
  @@index([responsibilityId])
}

model PurchaseOrder {
  id                   String @id @default(uuid()) @db.Uuid
  reference            String @unique @default(dbgenerated("('PO-'::text || nextval('purchase_order_reference_seq'::regclass)::text)")) @db.VarChar(40)
  projectId            String @db.Uuid
  supplierId           String @db.Uuid
  requesterId          String @db.Uuid
  sourceRuleId         String? @db.Uuid
  rulesRevisionSnapshot Int
  lowerSnapshot        Decimal? @db.Decimal(18, 2)
  upperSnapshot        Decimal? @db.Decimal(18, 2)
  projectNameSnapshot  String @db.VarChar(120)
  supplierNameSnapshot String @db.VarChar(160)
  orderDate            DateTime @db.Date
  notes                String? @db.VarChar(2000)
  total                Decimal @db.Decimal(18, 2)
  status               OrderStatus @default(pending)
  currentStepPosition  Int? @default(1)
  version              Int @default(1)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  project              Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  supplier             Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  requester            User @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  sourceRule           ApprovalRule? @relation(fields: [sourceRuleId], references: [id], onDelete: SetNull)
  items                OrderItem[]
  steps                ApprovalStep[]

  @@index([projectId, createdAt, id])
  @@index([requesterId, createdAt, id])
  @@index([status, createdAt, id])
  @@index([supplierId])
  @@index([sourceRuleId])
}

model OrderItem {
  id          String @id @default(uuid()) @db.Uuid
  orderId     String @db.Uuid
  position    Int
  description String @db.VarChar(500)
  quantity    Decimal @db.Decimal(9, 3)
  unit        String @db.VarChar(10)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(18, 2)
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, position])
}

model ApprovalStep {
  id                   String @id @default(uuid()) @db.Uuid
  orderId              String @db.Uuid
  responsibilityId     String @db.Uuid
  assignedOperatorId   String @db.Uuid
  operatorNameSnapshot String @db.VarChar(120)
  position             Int
  status               StepStatus
  decidedById          String? @db.Uuid
  decidedAt            DateTime? @db.Timestamptz(3)
  rejectionReason      String? @db.VarChar(1000)
  order                PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  responsibility       ProjectResponsibility @relation(fields: [responsibilityId], references: [id], onDelete: Restrict)
  assignedOperator     User @relation("Assignee", fields: [assignedOperatorId], references: [id], onDelete: Restrict)
  decidedBy            User? @relation("Decider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@unique([orderId, position])
  @@unique([orderId, assignedOperatorId])
  @@index([assignedOperatorId, orderId])
  @@index([responsibilityId, status])
  @@index([decidedById])
}
